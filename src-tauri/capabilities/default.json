{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main schedule window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://rasp.rsue.ru/*"
        },
        {
          "url": "https://github.com/fresh-milkshake"
        }
      ]
    },
    "notification:default"
  ]
}
