{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Расписание РИНХ",
  "version": "1.0.0",
  "identifier": "ru.rsuer.rhythm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "Расписание РИНХ",
      "width": 430,
      "height": 900,
      "minWidth": 320,
      "minHeight": 600,
      "backgroundColor": "#000000"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://rasp-api.rsue.ru"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Fresh Milkshake",
    "copyright": "Copyright © 2026 Fresh Milkshake",
    "category": "Education",
    "shortDescription": "Расписание РГЭУ (РИНХ)",
    "longDescription": "Занятия по дням и неделям, аудитории и преподаватели, просмотр сохранённого расписания без сети и локальные напоминания об окончании учебного дня. Разработчик: Fresh Milkshake.",
    "licenseFile": "../LICENSE",
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "android": { "minSdkVersion": 24 }
  }
}
